{
  "permissions": {
    "allow": [
      "Bash(npm run hackertest)",
      "Bash(npm test)",
      "Bash(npm audit*)",
      "Bash(git status*)",
      "Bash(git diff*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./data/**)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(more .env*)",
      "Bash(less .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)"
    ]
  }
}
