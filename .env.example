# Vorlage für deine lokale .env-Datei.
# Am einfachsten: "npm run setup" ausführen, das legt die .env für dich an.
# Die echte .env landet NIE auf GitHub (steht in .gitignore).

# Adresse deiner App. Lokal: http://localhost:3000, online: https://deine-domain.de
BASE_URL=http://localhost:3000
NODE_ENV=development

# Aus der Twitch Developer Console (dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Dein Twitch-Kanalname (Login-Name, klein geschrieben)
TWITCH_CHANNEL=

# Zufällige Geheimnisse, "npm run setup" erzeugt sie automatisch
EVENTSUB_SECRET=
OVERLAY_KEY=
# 64 Hex-Zeichen, verschlüsselt das gespeicherte Streamer-Token
TOKEN_ENCRYPTION_KEY=

# Online (Hostinger): mysql://BENUTZER:PASSWORT@HOST:3306/DATENBANK
# Lokal leer lassen, dann nutzt die App eine SQLite-Datei in ./data
DATABASE_URL=

# Nur lokal: Stream gilt immer als live, damit du den Check-in testen kannst.
# Wird online automatisch ignoriert.
DEV_ALWAYS_LIVE=true
